<?xml version="1.0" encoding="UTF-8"?><ui version="4.0"><class>SettingsDialog</class><widget class="QDialog" name="settingsDialog"><property name="windowTitle"><string>Settings</string></property><property name="accessibleName"><string>Settings dialog</string></property><property name="accessibleDescription"><string>Configure calculation, viewer, export, and layout defaults.</string></property><layout class="QVBoxLayout" name="layoutSettingsDialog"><item><widget class="QTabWidget" name="settingsTabs"><property name="accessibleName"><string>Settings categories</string></property><property name="accessibleDescription"><string>Settings categories.</string></property><widget class="QWidget" name="settingsGeneralPage"><attribute name="title"><string>General</string></attribute><layout class="QVBoxLayout" name="layoutSettingsGeneral"><item><widget class="QLabel" name="labelSettingsGeneral"><property name="text"><string>Settings are applied with OK and restored with Restore Defaults.</string></property></widget></item></layout></widget><widget class="QWidget" name="settingsCalculationPage"><attribute name="title"><string>Calculation defaults</string></attribute><layout class="QVBoxLayout" name="layoutSettingsCalculation"/></widget><widget class="QWidget" name="settingsViewerPage"><attribute name="title"><string>Viewer appearance</string></attribute><layout class="QVBoxLayout" name="layoutSettingsViewer"/></widget></widget></item><item><widget class="QDialogButtonBox" name="settingsButtonBox"><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok|QDialogButtonBox::RestoreDefaults</set></property><property name="accessibleName"><string>Settings dialog actions</string></property><property name="accessibleDescription"><string>Settings dialog actions.</string></property></widget></item></layout></widget><resources/><connections/></ui>