<?xml version="1.0" encoding="UTF-8"?><ui version="4.0"><class>AddGridDialog</class><widget class="QDialog" name="addGridDialog"><property name="windowTitle"><string>Add Grid</string></property><property name="accessibleName"><string>Add grid dialog</string></property><property name="accessibleDescription"><string>Add grid dialog.</string></property><layout class="QFormLayout" name="layoutAddGrid"><item row="0" column="0"><widget class="QLabel" name="labelAddGridName"><property name="text"><string>Grid name</string></property></widget></item><item row="0" column="1"><widget class="QLineEdit" name="editAddGridName"><property name="accessibleName"><string>Grid name</string></property><property name="accessibleDescription"><string>Enter a unique grid name.</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="labelAddGridType"><property name="text"><string>Grid type</string></property></widget></item><item row="1" column="1"><layout class="QVBoxLayout" name="layoutAddGridType"><item><widget class="QRadioButton" name="radioAddRegularGrid"><property name="text"><string>Regular</string></property><property name="checked"><bool>true</bool></property><property name="accessibleName"><string>Regular grid type</string></property><property name="accessibleDescription"><string>Regular grid type.</string></property></widget></item><item><widget class="QRadioButton" name="radioAddIrregularGrid"><property name="text"><string>Irregular</string></property><property name="accessibleName"><string>Irregular grid type</string></property><property name="accessibleDescription"><string>Irregular grid type.</string></property></widget></item></layout></item><item row="2" column="0"><widget class="QLabel" name="labelAddGridSubdivisions"><property name="text"><string>Subdivisions</string></property></widget></item><item row="2" column="1"><widget class="QSpinBox" name="spinAddGridSubdivisions"><property name="minimum"><number>1</number></property><property na